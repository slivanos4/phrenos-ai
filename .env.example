# Public Web3Forms access key (safe for client-side use)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Free site analytics (optional — omit to disable)
# Microsoft Clarity: https://clarity.microsoft.com → project → Settings → Setup
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Google Analytics 4: https://analytics.google.com → Admin → Data streams → Measurement ID (G-…)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Phrenos AI Updates pipeline (server only) ---
# Copy this file to .env.local and fill in real values.
# Never put secrets in .env.example

# Supabase project (NEXT_PUBLIC_SUPABASE_URL or SUPABASE_URL is accepted)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Research and content generation
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
# Optional model override, defaults to claude-sonnet-4-6
ANTHROPIC_MODEL=

# Admin access to /admin/ai-updates
PHRENOS_ADMIN_PASSWORD=
# Optional. Falls back to a hash of the admin password when unset
PHRENOS_ADMIN_SECRET=

# Weekly cron trigger (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
